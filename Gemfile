source "https://rubygems.org"

# Pinned so local builds and CI agree. The site was previously built by the
# legacy GitHub Pages pipeline (Jekyll 3.10) while the gemspec assumed Jekyll 4,
# which meant local and production were never running the same code.
gem "jekyll", "~> 4.3"
gem "jekyll-seo-tag", "~> 2.8"
gem "jekyll-sitemap", "~> 1.4"
gem "kramdown-parser-gfm", "~> 1.1"

# Ruby 3.4 no longer bundles these as default gems.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

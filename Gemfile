source "https://rubygems.org"

# Pinned so local builds and CI agree. Previously the Gemfile deferred to
# forty_jekyll_theme.gemspec (which assumes Jekyll 4) while GitHub Pages built
# the site with Jekyll 3.10, so local and production never ran the same code.
gem "jekyll", "~> 4.3"
gem "jekyll-seo-tag", "~> 2.8"

# Ruby 3.4 no longer bundles these as default gems.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
